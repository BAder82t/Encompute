# Encompute evaluator image: the "machine B" of the demos.
# Contains only encompute-evaluator (no client crypto, no keys, no models);
# clients upload programs and evaluation keys over HTTP.
#
#   docker build -f Dockerfile.evaluator -t encompute-evaluator .
#   docker run --rm -p 8750:8750 encompute-evaluator
#
# The default image runs approximate programs on OpenFHE CKKS and exact ones
# on OpenFHE exact (BinFHE); it contains no TFHE-rs. A research image with
# TFHE-rs (research use only; commercial use needs a patent license from Zama):
#   docker build -f Dockerfile.evaluator --build-arg FEATURES=openfhe,research-tfhe-rs -t encompute-evaluator-research .

FROM rust:1.98-bookworm AS build
RUN apt-get update && apt-get install -y --no-install-recommends cmake git g++ && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY scripts/install-openfhe.sh scripts/
RUN ./scripts/install-openfhe.sh /opt/openfhe
COPY . .
ARG FEATURES=openfhe
RUN OPENFHE_ROOT=/opt/openfhe cargo build --release --locked -p encompute-evaluator --features "${FEATURES}" \
 && ./scripts/audit-evaluator-binary.sh target/release/encompute-evaluator

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10001 evaluator
COPY --from=build /src/target/release/encompute-evaluator /usr/local/bin/encompute-evaluator
USER evaluator
EXPOSE 8750
# Each program runs on the real backend for its semantics that this image
# was built with (OpenFHE CKKS for approximate, OpenFHE exact for exact).
ENTRYPOINT ["encompute-evaluator", "serve", "--listen", "0.0.0.0:8750"]
CMD ["--workers", "2"]
