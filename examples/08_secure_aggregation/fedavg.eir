encompute 0.1
program fedavg precision 0.001 purpose "disease-training"
party "coordinator" "Coordinator"
party "hospital-a" "Hospital A"
party "hospital-b" "Hospital B"
party "hospital-c" "Hospital C"
asset "gradient-a" gradient owners ["hospital-a"] readers ["coordinator"] purposes ["disease-training"] release aggregate_only
asset "gradient-b" gradient owners ["hospital-b"] readers ["coordinator"] purposes ["disease-training"] release aggregate_only
asset "gradient-c" gradient owners ["hospital-c"] readers ["coordinator"] purposes ["disease-training"] release aggregate_only
%0 = input "ga" [-1.0, 1.0] asset "gradient-a" : secret vector<16>
%1 = input "gb" [-1.0, 1.0] asset "gradient-b" : secret vector<16>
%2 = input "gc" [-1.0, 1.0] asset "gradient-c" : secret vector<16>
%3 = add %0, %1 : secret vector<16>
%4 = add %3, %2 : secret vector<16>
output "global_gradient" = %4 to "coordinator"
aggregate "global_gradient" sum minimum 3 colluding 2 clip [-1.0, 1.0] scale 65536 modulus 32
