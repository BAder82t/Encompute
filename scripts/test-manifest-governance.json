{
  "manifest_version": 1,
  "extends": "test-manifest.json",
  "comment": "The governance branch's full run: main's manifest (extends) with every minimum raised to what this tree measured, the suites it adds, and the runs that are not cargo test (the assurance report, the governance attack suite, the backup drill, the public-sector examples; read by marker and count lines). A minimum can only go up here, and a lower number anywhere is a test removed: reviewed. Run it with scripts/test-governance-full.sh.",
  "runs": [
    {"id": "control-plane", "min_tests": 574, "min_db_backed": 388, "allowed_skips": [{"match": "spend_latency", "reason": "a latency benchmark run by hand: cargo test --release -p encompute-control --test spend_latency -- --ignored --nocapture"}]},
    {"id": "cli", "min_tests": 61},
    {"id": "workspace-rest", "min_tests": 600},
    {"id": "assurance", "command": ["bash", "-c", "cargo build -q --release -p encompute-assurance --bins --examples && target/release/assurance-report"], "parser": "lines", "needs": ["openfhe"], "min_tests": 18},
    {"id": "governance-attacks", "command": ["scripts/governance-attacks.sh"], "parser": "lines", "needs": ["postgres", "openbao", "openfhe"], "min_tests": 27, "min_db_backed": 20},
    {"id": "backup-drill", "command": ["scripts/release/backup-drill.sh"], "parser": "lines", "needs": ["postgres", "openbao", "openfhe"], "min_tests": 51},
    {"id": "public-sector-examples", "command": ["bash", "-c", "cargo build -q --bins && BIN=target/debug EXAMPLES_REQUIRE='public-sector/public-health-statistics public-sector/fraud-signal' EXAMPLES_ONLY='public-sector/public-health-statistics public-sector/fraud-signal' examples/run-all.sh quick"], "parser": "lines", "needs": ["openfhe"], "min_tests": 2}
