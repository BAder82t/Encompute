    {"id": "tfhe-research", "command": ["cargo", "test", "--release", "-p", "encompute-tfhe", "-p", "encompute-tfhe-client", "--features", "encompute-tfhe-client/research-tfhe-rs"], "needs": ["tfhe"], "min_tests": 1, "allow_unavailable": [{"dep": "tfhe", "reason": "TFHE-rs is a research feature, never shipped; the run needs ENCOMPUTE_TFHE=1"}]},
    {"id": "cold-core", "command": ["cargo", "test", "-p", "encompute-control", "--test", "smoke", "--test", "scheduling", "--test", "anchor_rollback", "--test", "anchor_size_brokers_recovery", "--test", "restart"], "needs": ["postgres", "openbao"], "default": false, "min_tests": 29},
