  "manifest_version": 1,
  "comment": "What a full test run must execute, and the least it may report. Reviewed whenever a minimum changes: a lower number is a test removed. Suite names are <package>/<test target>; a suite is required unless it says otherwise. A skip is an error unless allowed_skips names it with its reason; a run may be unavailable only if allow_unavailable says so.",
  "runs": [
    {"id": "control-plane", "command": ["cargo", "test", "-p", "encompute-control", "-p", "encompute-keybroker", "-p", "encompute-verification"], "needs": ["postgres", "openbao", "tls-postgres"], "min_tests": 180, "min_db_backed": 88},
