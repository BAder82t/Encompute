encompute 0.1
program eligibility precision 0.001
# examples/02_exact_private_logic/eligibility.py as IR.
%0 = input "age" [0.0, 120.0] : secret u8
%1 = input "income" [0.0, 1000000.0] : secret u32
%2 = input "debt" [0.0, 500000.0] : secret u32
%3 = input "risk" [0.0, 1000.0] : secret u16
%4 = const [18.0] : public u8
%5 = ge %0, %4 : secret bool
%6 = const [100.0] : public u32
%7 = mul %2, %6 : secret u32
%8 = const [40.0] : public u32
%9 = mul %1, %8 : secret u32
%10 = lt %7, %9 : secret bool
%11 = const [650.0] : public u16
%12 = le %3, %11 : secret bool
%13 = and %5, %10 : secret bool
%14 = and %13, %12 : secret bool
output "eligible" = %14
