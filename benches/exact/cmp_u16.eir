encompute 0.1
program cmp_u16 precision 0.001
# Comparisons of two u16 values (declared range [0, 50000]).
%0 = input "x" [0.0, 50000.0] : secret u16
%1 = input "y" [0.0, 50000.0] : secret u16
%2 = const [30000.0] : public u16
%3 = lt %0, %1 : secret bool
%4 = le %0, %1 : secret bool
%5 = eq %0, %1 : secret bool
%6 = gt %0, %2 : secret bool
%7 = ne %1, %2 : secret bool
output "lt" = %3
output "le" = %4
output "eq" = %5
output "x_gt_30000" = %6
output "y_ne_30000" = %7
