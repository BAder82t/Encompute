; The key broker's connection to the root-key provider. The broker's HTTPS
; client trusts only the built-in public web roots, so it cannot verify a
; private CA. It connects to this sidecar over loopback (they share a network
; namespace; plain HTTP is accepted by the broker only on loopback), and the
; sidecar speaks TLS to OpenBao, verifying its certificate chain and name.
; BAO_UPSTREAM (host:port) and BAO_SERVER_NAME are substituted at start.
foreground = yes
debug = notice
sslVersionMin = TLSv1.2

[openbao]
client = yes
accept = 127.0.0.1:8200
connect = @BAO_UPSTREAM@
verifyChain = yes
CAfile = /run/secrets/bao-ca.crt
checkHost = @BAO_SERVER_NAME@
