# The `encompute` CLI as a service image: the key broker (`keys serve`) and
# the secure-aggregation coordinator (`aggregate serve`). No OpenFHE: neither
# computes on ciphertexts.
#
#   docker build -f Dockerfile.services -t encompute-services .

FROM rust:1.98.1-bookworm@sha256:93ce27a88655056a51dbdd8f5f2d7ddc071c7b0070fb288a37b5a285fc83971e AS build
WORKDIR /src
COPY . .
RUN cargo build --release --locked -p encompute-cli

FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
RUN apt-get update && apt-get install -y --no-install-recommends --only-upgrade perl-base libpcre2-8-0 && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10003 encompute \
 && mkdir -p /var/lib/encompute && chown encompute /var/lib/encompute
COPY --from=build /src/target/release/encompute /usr/local/bin/encompute
USER encompute
WORKDIR /var/lib/encompute
ENTRYPOINT ["encompute"]
